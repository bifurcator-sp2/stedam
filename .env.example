APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US


FILAMENT_PATH=ad
LOCALES=ru,en
PUBLIC_ROLES_COUNT=1

FILES_MAX_IMAGES=100
FILES_MAX_FILES=20

LEARN_ARCHIVE_ENABLED=true        # глобальный выключатель
LEARN_ARCHIVE_CHUNK=500
LEARN_ARCHIVE_GRADED_DAYS=365     # graded  → архив через N дней после complete_date
LEARN_ARCHIVE_CREATED_DAYS=90     # created → архив через N дней после created_at
LEARN_ARCHIVE_SCHEDULED_DAYS=90   # scheduled → архив через N дней после created_at

# --- Learn: изображения ответов ученика (перо) ---
# Диск хранения (публичный S3) и корневой префикс шардированной структуры:
#   {prefix}/{learnId % 1000:03}/{learnId}/{index}.{ext}
LEARN_ANSWERS_DISK=s3_public
LEARN_ANSWERS_PREFIX=answers

# Главный выключатель обработки.
# false = файл сохраняется байт-в-байт (pass-through), без decode/resize/encode,
#         расширение берётся из исходника.
LEARN_ANSWERS_TRANSCODE=true

# Ресайз по большой стороне (действует только при TRANSCODE=true).
LEARN_ANSWERS_RESIZE=true
LEARN_ANSWERS_MAX_SIDE=1024

# Конвертация в webp (действует только при TRANSCODE=true).
# false = сохранять в исходном формате после ресайза.
LEARN_ANSWERS_CONVERT_TO_WEBP=true
LEARN_ANSWERS_QUALITY=80

# Валидация входящих файлов.
LEARN_ANSWERS_MAX_BYTES=10485760
LEARN_ANSWERS_ALLOWED_MIMES=image/png,image/jpeg,image/webp
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
